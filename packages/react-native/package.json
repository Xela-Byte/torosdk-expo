{
  "name": "@reactforge/react-native",
  "version": "0.1.1",
  "description": "React Native & Expo SDK toolkit for Toronet — secure password storage, biometric auth, TanStack Query hooks, and CLI init",
  "main": "dist/react/index.js",
  "types": "dist/react/index.d.ts",
  "bin": {
    "toroforge-rn": "./dist/cli/init.js"
  },
  "exports": {
    ".": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./cli": "./dist/cli/init.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && node -e \"const fs = require('fs'); fs.cpSync('src/cli/templates', 'dist/cli/templates', { recursive: true });\"",
    "test": "jest --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "toronet",
    "toroforge",
    "expo",
    "react-native",
    "blockchain",
    "wallet"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@tanstack/react-query": ">=5.0.0",
    "expo-local-authentication": ">=14.0.0",
    "expo-secure-store": ">=12.0.0",
    "react": ">=18.0.0",
    "react-native": ">=0.73.0"
  },
  "peerDependenciesMeta": {
    "expo-local-authentication": {
      "optional": true
    }
  },
  "dependencies": {
    "@reactforge/sdk-adapter": "workspace:*",
    "axios": ">=1.7.0"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.0.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "expo-local-authentication": "^14.0.0",
    "expo-secure-store": "^13.0.0",
    "jest": "^29.7.0",
    "react": "^19.0.0",
    "ts-jest": "^29.4.14",
    "typescript": "^5.3.0"
  }
}